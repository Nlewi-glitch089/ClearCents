# Example environment variables (never commit real secrets)
# Copy this to .env.local and populate with real values in your local dev environment.
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
OPENAI_KEY="your-openai-key-here"
SESSION_SECRET="a-very-secure-random-string"
VERCEL_OIDC_TOKEN="(optional-vercel-oidc-token-if-needed)"
# Copy this file to `.env.local` and fill in real values (DO NOT commit secrets).

# PostgreSQL (Neon) connection string. Example format:
# DATABASE_URL="postgresql://USER:PASSWORD@host:5432/dbname?sslmode=require"
DATABASE_URL=

# OpenAI API key (server-side only). Create & store in OpenAI dashboard.
OPENAI_KEY=
# Copy to .env.local and fill values
DATABASE_URL=postgresql://username:password@host:5432/dbname
NEXT_PUBLIC_OPENAI_KEY=your-openai-key
# Other secrets:
# SESSION_SECRET=super-secret
