# Copy this file to .env.local and fill in real values. DO NOT commit .env.local to git.

# PostgreSQL (Neon) connection string.
DATABASE_URL=

# OpenAI API key — server-side only. Obtain from platform.openai.com/api-keys.
# IMPORTANT: This key must NEVER be prefixed with NEXT_PUBLIC_. A NEXT_PUBLIC_ prefix
# causes Next.js to embed the key value in the client-side JavaScript bundle,
# exposing it publicly to all visitors. Use OPENAI_API_KEY exactly as shown.
OPENAI_API_KEY=

# Session secret — used to sign JWT tokens. Use a long random string.
SESSION_SECRET=

# Vercel OIDC token (optional).
VERCEL_OIDC_TOKEN=
